---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MessageForm from '../components/MessageForm.astro';
import { LINKS } from '../lib/links';
import '../styles/pages.css';
---
<Base
  title="Contact — Greg Weinger"
  description="Get in touch with Greg Weinger — help getting unstuck in your career, podcast guest inquiries, speaking, media, or just to connect."
>
  <PageHero
    eyebrow="Contact"
    title="Stuck in your career? Let's talk."
    lead="Career help has its own page. Guest ideas, questions about the show and everything else go through the form below."
  />

  <section class="band band--light">
    <div class="band-inner contact-grid">
      <div class="contact-main">
        <div class="contact-help">
          <h2 class="eyebrow">Stuck at work?</h2>
          <p>Doing great work and still getting passed over? Tell me what's going on, and I'll write back personally.</p>
          <a class="btn-gold" href="/get-unstuck/?from=contact">Tell me where you're stuck →</a>
        </div>

        <section class="contact-card">
          <h2>Send me a message</h2>

          <MessageForm source="contact" />
        </section>
      </div>

      <aside class="contact-side">
        <h2 class="eyebrow">Find me here</h2>
        <div class="band-actions link-buttons">
          <a class="btn-primary" href={LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="btn-primary" href={LINKS.substack} target="_blank" rel="noopener noreferrer">Substack</a>
          <a class="btn-primary" href={LINKS.apple} target="_blank" rel="noopener noreferrer">Apple Podcasts</a>
          <a class="btn-primary" href={LINKS.spotify} target="_blank" rel="noopener noreferrer">Spotify</a>
          <a class="btn-primary" href={LINKS.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
        </div>

        <h2 class="eyebrow">Contact me about</h2>
        <ul class="contact-reasons">
          <li>Getting unstuck in your career</li>
          <li>Podcast guest pitches</li>
          <li>Speaking &amp; media inquiries</li>
          <li>Feedback on the show or newsletter</li>
          <li>Anything else</li>
        </ul>
      </aside>
    </div>
  </section>

</Base>
