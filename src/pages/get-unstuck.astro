---
// The hand-raise page. Since 2026-10-24 it offers a free 30-minute call
// (November plan): a visitor says what's going on and why now, and
// Greg replies by hand with times to talk. There is deliberately no booking
// link on the page (day-job precaution). The form is the contact form's,
// posted to the same worker, so requests land in Greg's inbox tagged with
// this page and the visitor's ?from= / UTM tags. /questionnaire/, /stuck,
// /unstuck and /call all redirect here (public/_redirects, generated from
// STATIC_REDIRECTS in podcast-studio's site_build.py).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MessageForm from '../components/MessageForm.astro';
import '../styles/pages.css';

const OG_IMAGE = new URL('/og-get-unstuck.png', Astro.site).href;
---
<Base
  title="Book a free 30-minute call — Greg Weinger"
  description="Stepping into a new role, going for a promotion, or proving yourself to a new boss? Tell me what's going on, and I'll reply within a day with times for a free 30-minute call."
>
  <Fragment slot="head">
    <meta property="og:url" content={new URL('/get-unstuck/', Astro.site).href} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content="Stuck at work? Tell me what's going on — Greg Weinger, The Introverted Leader" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={OG_IMAGE} />
  </Fragment>

  <PageHero
    eyebrow="Free 30-minute call"
    title="Book a free 30-minute call."
    lead="Tell me what's going on at work. I read every one myself and reply within a day with times to talk."
  />

  <section class="band band--light">
    <div class="band-inner contact-grid">
      <div class="contact-main">
        <section class="contact-card">
          <MessageForm
            source="get-unstuck"
            messageFirst
            messageLabel="What's going on?"
            messagePlaceholder="For example: I start as a director next month, and my first exec staff meeting is on the calendar."
            whenLabel="Why now?"
            whenPlaceholder="For example: my review is Nov 12, or I start the new role Dec 1"
            button="Request my free call →"
            success="Got it. I'll read it myself and reply within a day with a few times to talk. — Greg"
          />
        </section>
      </div>

      <aside class="contact-side">
        <h2 class="eyebrow">This is for you if you're</h2>
        <ul class="contact-reasons">
          <li>Stepping into a new role</li>
          <li>Going for a promotion</li>
          <li>Proving yourself to a new boss</li>
          <li>Doing great work and still getting passed over</li>
        </ul>

        <h2 class="eyebrow">What happens next</h2>
        <ol class="contact-reasons">
          <li>I reply within a day with a few times.</li>
          <li>We talk for 30 minutes about your situation.</li>
          <li>If working together would help, I'll tell you what that would look like.</li>
        </ol>
        <p>It comes straight to my inbox. No mailing list.</p>
      </aside>
    </div>
  </section>
</Base>
