---
import Base from '../../layouts/Base.astro';
import MessageForm from '../../components/MessageForm.astro';

// Unlisted YouTube upload of the masterclass. The page is only reachable
// via the Kit form's success redirect, and is noindexed — the email gate
// is the front door.
const YOUTUBE_VIDEO_ID = 'jONP2b3XG3U';

// Nov 2026 re-edit (_showrunner/masterclass/masterclass-reedit-2026-11.md):
// the Four Themes / Labs section is cut. Timestamps from the 26:31 export.
const CHAPTERS = [
  { time: '00:00', title: 'The Meeting You Lost (And Why)' },
  { time: '04:51', title: "The Real Problem Isn't Confidence" },
  { time: '13:45', title: 'The 3 Moments That Get Your Work Seen' },
  { time: '24:11', title: 'The Quiet Leader Who Saved the Company' },
];
---
<Base
  title="Watch: Why Everything You've Been Told About Getting Ahead as an Introvert Is Wrong | Greg Weinger"
  description="The free masterclass for introverted leaders, in full."
  minimalHeader
>
  <meta slot="head" name="robots" content="noindex" />
  <div class="container">
    <h1>Why Everything You've Been Told About Getting Ahead as an Introvert Is Wrong</h1>
    <p class="lead">You're in — press play. About 26 minutes, best watched in one sitting.</p>

    <div class="masterclass-player">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${YOUTUBE_VIDEO_ID}?rel=0`}
        title="Masterclass: Why Everything You've Been Told About Getting Ahead as an Introvert Is Wrong"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>

    <section>
      <h2 class="home-section-label">Chapters</h2>
      <ol class="masterclass-chapters">
        {CHAPTERS.map((chapter) => (
          <li><span class="masterclass-chapter-time">{chapter.time}</span> {chapter.title}</li>
        ))}
      </ol>
    </section>

    {/* Next step = the free 30-minute call, framed around the video's own
        homework (pause, open your calendar, find the moment). The form posts
        to the contact worker like /get-unstuck/, tagged source "masterclass"
        so requests from viewers are countable. */}
    <section class="masterclass-next-step" id="call">
      <h2 class="home-section-label">Found your moment?</h2>
      <p>At the end of the masterclass, I ask you to find one moment on your calendar that matters: a review, a big meeting, a conversation you've been putting off. Tell me what it is, and we'll prepare for it together on a free 30-minute call.</p>
      <p>I read every message myself and reply within a day with a few times to talk.</p>
      <MessageForm
        source="masterclass"
        messageFirst
        messageLabel="What's the moment?"
        messagePlaceholder="For example: my review is next month, and I want to make the case for the next level."
        whenLabel="When is it?"
        whenPlaceholder="For example: Dec 4"
        rows={4}
        button="Request my free call →"
        success="Got it. I'll read it myself and reply within a day with a few times to talk. — Greg"
      />
    </section>
  </div>
</Base>
