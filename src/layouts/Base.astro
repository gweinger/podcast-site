---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { NAV, isCurrent } from '../lib/nav';
interface Props { title: string; description?: string; canonical?: string; minimalHeader?: boolean; }
const { title, description = '', canonical, minimalHeader = false } = Astro.props;
const path = Astro.url.pathname;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@500;600;700&display=swap" rel="stylesheet">
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <slot name="head" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VS31RSZZ8K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-VS31RSZZ8K');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">Greg Weinger</a>
        {!minimalHeader && (
          <>
            <nav class="nav-pill" aria-label="Main">
              {NAV.map((n) => (
                <a href={n.href} aria-current={isCurrent(path, n.href) ? 'page' : undefined}>{n.label}</a>
              ))}
            </nav>
            <a class="btn-gold header-cta" href="/masterclass">Free Masterclass</a>
          </>
        )}
      </div>
    </header>
    <main><slot /></main>
    <Footer />
  </body>
</html>
